diff --git a/src/test-ifname.c b/src/test-ifname.c
new file mode 100644
--- /dev/null
+++ b/src/test-ifname.c
@@ -0,0 +1,39 @@
+/* Exercise the service's actual validation without starting IPsec or PPP. */
+#define main nm_l2tp_service_main
+#include "nm-l2tp-service.c"
+#undef main
+
+int
+main(void)
+{
+    const char *valid[] = {"mdr-vpn", "other-vpn", "ppp0", "123456789012345", NULL};
+    const char *invalid[] = {"", "1234567890123456", "bad name", "bad\nname",
+                             "bad/name", "bad\"name", "bad#name", NULL};
+    GError *error = NULL;
+    ValidateInfo info = {valid_properties, &error, FALSE};
+    NMSettingVpn *vpn = NM_SETTING_VPN(nm_setting_vpn_new());
+
+    for (int i = 0; valid[i]; i++) {
+        validate_one_property("ifname", valid[i], &info);
+        g_assert_no_error(error);
+    }
+    for (int i = 0; invalid[i]; i++) {
+        validate_one_property("ifname", invalid[i], &info);
+        g_assert_error(error, NM_VPN_PLUGIN_ERROR, NM_VPN_PLUGIN_ERROR_BAD_ARGUMENTS);
+        g_clear_error(&error);
+    }
+
+    nm_setting_vpn_add_data_item(vpn, NM_L2TP_KEY_GATEWAY, "vpn.example.org");
+    g_assert_true(nm_l2tp_properties_validate(vpn, &error));
+    g_assert_no_error(error);
+    nm_setting_vpn_add_data_item(vpn, "ifname", "mdr-vpn");
+    g_assert_true(nm_l2tp_properties_validate(vpn, &error));
+    g_assert_no_error(error);
+    nm_setting_vpn_add_data_item(vpn, "ifname", "other-vpn");
+    g_assert_true(nm_l2tp_properties_validate(vpn, &error));
+    g_assert_no_error(error);
+    g_assert_cmpstr(nm_setting_vpn_get_data_item(vpn, "ifname"), ==, "other-vpn");
+    g_object_unref(vpn);
+
+    return 0;
+}
